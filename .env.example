# La aplicación ya trae valores por defecto para desarrollo local
# (MySQL en localhost:3306 con usuario root, claves JWT e interna incluidas),
# así que NO necesitas crear un .env para ejecutarla.
#
# Copia este archivo a .env SOLO si quieres sobreescribir algún valor.
# .env está en .gitignore: nunca se commitea.

# ---------- Base de datos ----------
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=IN5AM
# DB_PASSWORD=_odmon5Am

# ---------- Seguridad ----------
# Mínimo 32 caracteres (se valida al arrancar cada servicio).
# Debe ser idéntico en todos los servicios.
# JWT_SECRET=vet-in5am-clave-secreta-local-para-desarrollo-2026
# Duración del token en milisegundos (1 hora por defecto).
# JWT_EXPIRATION=3600000
# Clave para los endpoints /internal/** entre servicios.
# INTERNAL_SERVICE_KEY=vet-in5am-internal-key-local

# ---------- CORS ----------
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
