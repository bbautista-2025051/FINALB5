# Copia este archivo a .env y ajusta los valores antes de levantar el stack.
# .env está en .gitignore: nunca se commitea.

# ---------- Base de datos ----------
MYSQL_ROOT_PASSWORD=cambiar-root-password
DB_USERNAME=vet
DB_PASSWORD=cambiar-usuario-password
DB_PORT=3306

# ---------- Seguridad ----------
# Mínimo 32 caracteres (se valida al arrancar cada servicio).
JWT_SECRET=cambiar-por-una-clave-aleatoria-larga-de-al-menos-32-caracteres
# Duración del token en milisegundos (1 hora por defecto).
JWT_EXPIRATION=3600000
# Clave para los endpoints /internal/** entre servicios.
INTERNAL_SERVICE_KEY=cambiar-clave-interna-entre-servicios

# ---------- Puertos ----------
GATEWAY_PORT=8090

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
